{
  "name": "unpeek",
  "version": "1.6.1",
  "description": "Zero-config, call-graph-aware polymorphic AST obfuscation and passive runtime anti-tamper with <2% CPU overhead.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Woffluon/unpeek.git",
    "directory": "packages/unpeek"
  },
  "homepage": "https://woffluon.github.io/unpeek",
  "keywords": [
    "obfuscator",
    "anti-debug",
    "anti-tamper",
    "devtools",
    "sourcemap",
    "ast",
    "security",
    "unplugin",
    "vite",
    "nextjs",
    "webpack"
  ],
  "bin": {
    "unpeek": "./bin/unpeek.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": {
        "import": "./dist/browser.d.ts",
        "require": "./dist/browser.d.cts"
      },
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    },
    "./unplugin": {
      "types": {
        "import": "./dist/bundler/unplugin.d.ts",
        "require": "./dist/bundler/unplugin.d.cts"
      },
      "import": "./dist/bundler/unplugin.js",
      "require": "./dist/bundler/unplugin.cjs"
    },
    "./vite": {
      "types": {
        "import": "./dist/vite.d.ts",
        "require": "./dist/vite.d.cts"
      },
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "types": {
        "import": "./dist/webpack.d.ts",
        "require": "./dist/webpack.d.cts"
      },
      "import": "./dist/webpack.js",
      "require": "./dist/webpack.cjs"
    },
    "./rollup": {
      "types": {
        "import": "./dist/rollup.d.ts",
        "require": "./dist/rollup.d.cts"
      },
      "import": "./dist/rollup.js",
      "require": "./dist/rollup.cjs"
    },
    "./esbuild": {
      "types": {
        "import": "./dist/esbuild.d.ts",
        "require": "./dist/esbuild.d.cts"
      },
      "import": "./dist/esbuild.js",
      "require": "./dist/esbuild.cjs"
    },
    "./ast": {
      "types": {
        "import": "./dist/ast/index.d.ts",
        "require": "./dist/ast/index.d.cts"
      },
      "import": "./dist/ast/index.js",
      "require": "./dist/ast/index.cjs"
    },
    "./runtime": {
      "types": {
        "import": "./dist/runtime/index.d.ts",
        "require": "./dist/runtime/index.d.cts"
      },
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    }
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx benchmarks/overhead.bench.ts"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "unplugin": "^2.2.2"
  },
  "peerDependencies": {
    "esbuild": ">=0.18.0",
    "rollup": ">=3.0.0",
    "vite": ">=4.0.0",
    "webpack": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/estree": "^1.0.10",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "tsup": "^9.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
